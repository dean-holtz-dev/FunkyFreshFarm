@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.GuidePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "_Layout.cshtml";

	var title = string.IsNullOrWhiteSpace(Model.PageTitle) ? Model.Name : Model.PageTitle;
	ViewData["Title"] = title;

	// BodyText is IHtmlEncodedString: editor-authored HTML that UmbracoViewPage writes unencoded.
	// It is trusted backoffice input; Umbraco's default IHtmlSanitizer is a no-op.
	var hasBody = !string.IsNullOrWhiteSpace(Model.BodyText?.ToHtmlString());
}
<article class="guide container">
	<header class="page-header page-header--center">
		<p class="eyebrow">Growing guide</p>
		<h1>@title</h1>
	</header>

	@* Brand illustration for the guide template (static asset); see docs/05-assets.md. *@
	<figure class="guide__art">
		<img src="/brand/guide-1280.jpg" srcset="/brand/guide-640.jpg 640w, /brand/guide-1280.jpg 1280w"
			 sizes="(min-width: 56rem) 56rem, 92vw" width="1280" height="853"
			 alt="Illustration of a tomato plant growing from seed to sprout to a fruiting vine" decoding="async" />
	</figure>

	@if (hasBody)
	{
		<div class="rich-text">@Model.BodyText</div>
	}
	else
	{
		<p class="empty-state">This guide has no content yet.</p>
	}
</article>
