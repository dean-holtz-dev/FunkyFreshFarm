@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.PlantPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "_Layout.cshtml";

	var name = string.IsNullOrWhiteSpace(Model.CommonName) ? Model.Name : Model.CommonName;
	ViewData["Title"] = name;

	var directory = Model.Parent();
}
<article class="plant-profile container">
	@if (directory is not null)
	{
		<p class="back-link"><a href="@directory.Url()">&larr; Back to @directory.Name</a></p>
	}

	<div class="plant-profile__layout">
		@if (Model.PlantImage is not null)
		{
			<figure class="plant__image">
				@await Html.PartialAsync("PlantIllustration", (Model.PlantImage, $"Botanical illustration of {name}", "plant__img",
					"(min-width: 70rem) 33rem, (min-width: 48rem) 46vw, 92vw", new[] { 480, 720, 960, 1254 }, false))
			</figure>
		}

		<div class="plant-profile__text">
			<p class="eyebrow">Plant profile</p>
			<header>
				<h1>@name</h1>
				@if (!string.IsNullOrWhiteSpace(Model.ScientificName))
				{
					<p class="scientific-name">@Model.ScientificName</p>
				}
			</header>

			@if (!string.IsNullOrWhiteSpace(Model.Description))
			{
				<p class="plant__description">@Html.ReplaceLineBreaks(Model.Description)</p>
			}

			<dl class="facts">
				<dt>Sun exposure</dt>
				<dd>@(string.IsNullOrWhiteSpace(Model.SunExposure) ? "Not specified" : Model.SunExposure)</dd>
			</dl>
		</div>
	</div>
</article>
