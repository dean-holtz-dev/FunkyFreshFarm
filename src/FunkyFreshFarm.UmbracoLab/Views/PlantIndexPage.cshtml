@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.PlantIndexPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "_Layout.cshtml";

	var title = string.IsNullOrWhiteSpace(Model.PageTitle) ? Model.Name : Model.PageTitle;
	ViewData["Title"] = title;

	// The directory is the node's published Plant Page children, in backoffice sort order.
	var plants = Model.Children<ContentModels.PlantPage>().ToList();
}
<div class="container">
	<header class="page-header">
		<p class="eyebrow">Plant directory</p>
		<h1>@title</h1>
		@if (!string.IsNullOrWhiteSpace(Model.IntroText))
		{
			<p class="lead">@Html.ReplaceLineBreaks(Model.IntroText)</p>
		}
	</header>

	@if (plants.Count == 0)
	{
		<p class="empty-state">No plants have been published yet.</p>
	}
	else
	{
		<ul class="plant-grid">
			@for (var i = 0; i < plants.Count; i++)
			{
				@* The first row is likely above the fold, so only later cards load lazily. *@
				@await Html.PartialAsync("PlantCard", (plants[i], 2, i >= 3))
			}
		</ul>
	}
</div>
