# Repository-level ignores.
# Umbraco-specific rules for the web project live in
# src/FunkyFreshFarm.UmbracoLab/.gitignore (generated by the Umbraco template).

# IDE and editor state
.vs/
.idea/
*.user
*.suo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude Code per-user settings
.claude/settings.local.json

# Build output for any project added under src/ or tests/
[Bb]in/
[Oo]bj/
artifacts/
[Tt]est[Rr]esults/
*.binlog

# JSON schema files that Umbraco.Cms.Targets copies into every project referencing Umbraco
# (including the test project) on each build
appsettings-schema.json
appsettings-schema.*.json
umbraco-package-schema.json

# Local Umbraco runtime state, anywhere in the tree (defence in depth)
*.sqlite.db
*.sqlite.db-shm
*.sqlite.db-wal
appsettings.Local.json
**/umbraco/Logs/
**/umbraco/Data/TEMP/

# Logs and local database backups (see docs/01-installation.md)
*.log
backups/
